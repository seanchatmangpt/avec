---
to: "crates/avec-parquet/src/generated_compiled_manifest.rs"
force: true
sparql:
  results: |
    PREFIX av: <urn:avec:>
    SELECT DISTINCT ?width WHERE {
      ?layout av:hasBufferSlot ?slot .
      ?slot av:elementBitWidth ?width .
    } ORDER BY ?width
---

// GENERATED by ggen — specialization manifest table from av:BufferSlot
// widths (avec-pack ontology). Wave HWL4 parity proof against the
// hand-written table in crates/avec-parquet/src/compiled_manifest.rs.
//
// Derivation rule (identical on both sides):
//   Enc::Rle iff the SWAR hybrid codec carries the width
//   (crate::rle::decode_into accepts widths 1, 2, 4, 8 — so the
//   ontology-modeled widths 1 and 8 are Rle), Plain otherwise.
//
// The type/kernels named here resolve inside
// crates/avec-parquet/src/compiled_manifest.rs.

pub const SPECIALIZATION_MANIFEST: &[Spec] = &[
{% for row in results -%}
{%- set w = row.width | int -%}
{%- if w <= 8 %}
    Spec { width: {{ w }}, encoding: Enc::Rle, kernel: rle_w::<{{ w }}> },
{% else %}
    Spec { width: {{ w }}, encoding: Enc::Plain, kernel: plain_w::<{{ w }}> },
{% endif -%}
{%- endfor %}
];
